<?php
/** @var QualityDedupeExtension $this */
$selectedCategories = $this->getSelectedCategoryIds();
$selectedFeeds = $this->getSelectedFeedIds();
?>
<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />

	<p>
		Tick whole categories, individual feeds, or both. Nothing ticked means
		the extension does nothing.
	</p>

	<?php foreach ($this->getCategoriesWithFeeds() as $category) { ?>
		<fieldset class="group">
			<legend>
				<label>
					<input type="checkbox" name="categories[]"
						value="<?= $category->id() ?>"
						<?= in_array($category->id(), $selectedCategories, true) ? 'checked' : '' ?> />
					<strong><?= htmlspecialchars($category->name(), ENT_QUOTES) ?></strong>
					(all feeds)
				</label>
			</legend>

			<?php foreach ($category->feeds() as $feed) { ?>
				<div class="form-group">
					<label>
						<input type="checkbox" name="feeds[]"
							value="<?= $feed->id() ?>"
							<?= in_array($feed->id(), $selectedFeeds, true) ? 'checked' : '' ?> />
						<?= htmlspecialchars($feed->name(), ENT_QUOTES) ?>
					</label>
				</div>
			<?php } ?>
		</fieldset>
	<?php } ?>

	<div class="form-group form-actions">
		<button type="submit" class="btn btn-important">Save</button>
		<button type="reset" class="btn">Reset</button>
	</div>
</form>